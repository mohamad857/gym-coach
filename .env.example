# Firebase Configuration (اختياري - يعمل التطبيق 100% بدون إنترنت وبدون فيربيز محلياً)
# للحفظ السحابي التلقائي، أنشئ مشروع Firebase وضع بياناتك هنا وقم بإنشاء ملف .env
VITE_FIREBASE_API_KEY=AIzaSyExampleKey123456789
VITE_FIREBASE_AUTH_DOMAIN=gymcoach-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=gymcoach-app
VITE_FIREBASE_STORAGE_BUCKET=gymcoach-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

